# Copy to .env for local development. On Cloudflare, secrets are NOT read from
# this file - set them with `npx wrangler secret put <NAME>` (see README).

# Public tracking IDs (inlined at build time)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Order sheet + admin page (runtime secrets, never commit real values)
ORDERS_SCRIPT_URL=   # the Google Apps Script web app URL (ends in /exec)
ORDERS_SECRET=       # same value as SECRET in google-sheet/Code.gs
ADMIN_PASSWORD=      # password for /admin
